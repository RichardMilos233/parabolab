        (fun _a => ‖_a‖ ^ 2 ≤ (↑m + 1) * (‖b + ∑ j, a j • h j - c‖ ^ 2 + ∑ j, a j ^ 2 * ‖sampleMean (Y j) ω - h j‖ ^ 2))
        (rawEstimator_sub_eq Y a b c h ω)))
    (Trans.trans (norm_bias_add_sum_sq_le (b + ∑ j, a j • h j - c) fun j => a j • (sampleMean (Y j) ω - h j))
