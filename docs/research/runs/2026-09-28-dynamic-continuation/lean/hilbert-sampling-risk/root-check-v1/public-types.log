theorem EstimatorIntegrity.HilbertSamplingRisk.anchored_rawEstimator_sub_memLp.{u_1, u_2} : ∀ {Ω : Type u_1}
  {H : Type u_2} [inst : MeasurableSpace Ω] [inst_1 : NormedAddCommGroup H] [inst_2 : InnerProductSpace ℝ H]
  [CompleteSpace H] [inst_4 : MeasurableSpace H] [BorelSpace H] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] {m n : ℕ} (Y : Fin m → Fin n → Ω → H) (a : Fin m → ℝ) (b c : H),
  (∀ (j : Fin m) (i : Fin n), MeasureTheory.MemLp (Y j i) 2 μ) →
    ∀ (K : H → H),
      Continuous K →
        (∀ (z : H), ‖K z - c‖ ≤ ‖z - c‖) → MeasureTheory.MemLp (fun ω => K (rawEstimator Y a b ω) - c) 2 μ :=
fun {Ω} {H} [MeasurableSpace Ω] [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [MeasurableSpace H]
    [BorelSpace H] μ [MeasureTheory.IsProbabilityMeasure μ] {m n} Y a b c hY K hKcont hK =>
  have hraw := rawEstimator_sub_memLp μ Y a b c hY;
  have hrawMeas := rawEstimator_aestronglyMeasurable μ Y a b hY;
  have htargetMeas :=
    MeasureTheory.AEStronglyMeasurable.sub (Continuous.comp_aestronglyMeasurable hKcont hrawMeas)
      MeasureTheory.aestronglyMeasurable_const;
  MeasureTheory.MemLp.mono hraw htargetMeas (MeasureTheory.ae_of_all μ fun ω => hK (rawEstimator Y a b ω))
theorem EstimatorIntegrity.HilbertSamplingRisk.anchored_rawEstimator_sqNorm_integrable.{u_1, u_2} : ∀ {Ω : Type u_1}
  {H : Type u_2} [inst : MeasurableSpace Ω] [inst_1 : NormedAddCommGroup H] [inst_2 : InnerProductSpace ℝ H]
  [CompleteSpace H] [inst_4 : MeasurableSpace H] [BorelSpace H] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] {m n : ℕ} (Y : Fin m → Fin n → Ω → H) (a : Fin m → ℝ) (b c : H),
  (∀ (j : Fin m) (i : Fin n), MeasureTheory.MemLp (Y j i) 2 μ) →
    ∀ (K : H → H),
      Continuous K →
        (∀ (z : H), ‖K z - c‖ ≤ ‖z - c‖) → MeasureTheory.Integrable (fun ω => ‖K (rawEstimator Y a b ω) - c‖ ^ 2) μ :=
fun {Ω} {H} [MeasurableSpace Ω] [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [MeasurableSpace H]
    [BorelSpace H] μ [MeasureTheory.IsProbabilityMeasure μ] {m n} Y a b c hY K hKcont hK =>
  MeasureTheory.MemLp.integrable_norm_pow' (anchored_rawEstimator_sub_memLp μ Y a b c hY K hKcont hK)
