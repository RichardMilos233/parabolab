  have hrawInt := rawEstimator_sub_sqNorm_integrable μ Y a b c hY;
  Trans.trans
    (MeasureTheory.integral_mono hKint hrawInt fun ω =>
      (sq_le_sq₀ (norm_nonneg (K (rawEstimator Y a b ω) - c)) (norm_nonneg (rawEstimator Y a b ω - c))).mpr
        (hK (rawEstimator Y a b ω)))
    (rawEstimator_risk_le μ hn Y h V a b c β hβ hV hY hIndep hMean hMoment hBias)
def EstimatorIntegrity.HilbertSamplingRisk.boxClip.{u_1} : {I : Type u_1} →
  [Fintype I] → (I → ℝ) → (I → ℝ) → EuclideanSpace ℝ I → EuclideanSpace ℝ I :=
fun {I} [Fintype I] l u z => WithLp.toLp 2 fun i => max (l i) (min (u i) (z.ofLp i))
theorem EstimatorIntegrity.HilbertSamplingRisk.boxClip_apply.{u_1} : ∀ {I : Type u_1} [inst : Fintype I] (l u : I → ℝ)
  (z : EuclideanSpace ℝ I) (i : I), (boxClip l u z).ofLp i = max (l i) (min (u i) (z.ofLp i)) :=
fun {I} [Fintype I] l u z i => Eq.refl ((boxClip l u z).ofLp i)
theorem EstimatorIntegrity.HilbertSamplingRisk.boxClip_fixed.{u_1} : ∀ {I : Type u_1} [inst : Fintype I] (l u : I → ℝ)
  (c : EuclideanSpace ℝ I), (∀ (i : I), l i ≤ c.ofLp i) → (∀ (i : I), c.ofLp i ≤ u i) → boxClip l u c = c :=
fun {I} [Fintype I] l u c hlc hcu =>
  PiLp.ext fun i =>
    of_eq_true
      (Eq.trans
        (congrFun' (congrArg Eq (Eq.trans (congrArg (max (l i)) (min_eq_right (hcu i))) (max_eq_right (hlc i))))
          (c.ofLp i))
        (eq_self (c.ofLp i)))
theorem EstimatorIntegrity.HilbertSamplingRisk.boxClip_continuous.{u_1} : ∀ {I : Type u_1} [inst : Fintype I]
  (l u : I → ℝ), Continuous (boxClip l u) :=
fun {I} [Fintype I] l u =>
  id
    (Continuous.comp' (PiLp.continuous_toLp 2 fun x => ℝ)
      (continuous_pi fun i =>
        Continuous.sup continuous_const (Continuous.inf continuous_const (PiLp.continuous_apply 2 (fun x => ℝ) i))))
theorem EstimatorIntegrity.HilbertSamplingRisk.boxClip_sub_sqNorm_le.{u_1} : ∀ {I : Type u_1} [inst : Fintype I]
  (l u : I → ℝ) (c z : EuclideanSpace ℝ I),
  (∀ (i : I), l i ≤ c.ofLp i) → (∀ (i : I), c.ofLp i ≤ u i) → ‖boxClip l u z - c‖ ^ 2 ≤ ‖z - c‖ ^ 2 :=
fun {I} [Fintype I] l u c z hlc hcu =>
  Eq.mpr (id (congrArg (fun _a => _a ≤ ‖z - c‖ ^ 2) (EuclideanSpace.real_norm_sq_eq (boxClip l u z - c))))
    (Eq.mpr
      (id (congrArg (fun _a => ∑ i, (boxClip l u z - c).ofLp i ^ 2 ≤ _a) (EuclideanSpace.real_norm_sq_eq (z - c))))
      (Finset.sum_le_sum fun i hi =>
        id (EstimatorIntegrity.HilbertSamplingRisk.clip_sq_le✝ (l i) (u i) (c.ofLp i) (z.ofLp i) (hlc i) (hcu i))))
theorem EstimatorIntegrity.HilbertSamplingRisk.boxClip_sub_norm_le.{u_1} : ∀ {I : Type u_1} [inst : Fintype I]
  (l u : I → ℝ) (c z : EuclideanSpace ℝ I),
  (∀ (i : I), l i ≤ c.ofLp i) → (∀ (i : I), c.ofLp i ≤ u i) → ‖boxClip l u z - c‖ ≤ ‖z - c‖ :=
fun {I} [Fintype I] l u c z hlc hcu =>
  (sq_le_sq₀ (norm_nonneg (boxClip l u z - c)) (norm_nonneg (z - c))).mp (boxClip_sub_sqNorm_le l u c z hlc hcu)
