theorem EstimatorIntegrity.HilbertSamplingRisk.sampleMean_error_memLp.{u_1, u_2} : ∀ {Ω : Type u_1} {H : Type u_2}
  [inst : MeasurableSpace Ω] [inst_1 : NormedAddCommGroup H] [inst_2 : InnerProductSpace ℝ H] [CompleteSpace H]
  [inst_4 : MeasurableSpace H] [BorelSpace H] (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  {n : ℕ} (Y : Fin n → Ω → H),
  (∀ (i : Fin n), MeasureTheory.MemLp (Y i) 2 μ) →
    MeasureTheory.MemLp (fun ω => sampleMean Y ω - meanAverage μ Y) 2 μ :=
fun {Ω} {H} [MeasurableSpace Ω] [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [MeasurableSpace H]
    [BorelSpace H] μ [MeasureTheory.IsProbabilityMeasure μ] {n} Y hY =>
  have hsum := MeasureTheory.memLp_finsetSum' Finset.univ fun i x => centered_memLp μ (Y i) (hY i);
  have hscaled := MeasureTheory.MemLp.const_smul hsum (1 / ↑n);
  have heq :=
    funext fun ω =>
      Eq.mpr
        (id
          (congrArg (Eq (sampleMean Y ω - meanAverage μ Y))
            (congrArg (HSMul.hSMul (1 / ↑n)) (Finset.sum_apply ω Finset.univ fun c => centered μ (Y c)))))
        (sampleMean_sub_meanAverage μ Y ω);
  Eq.mpr (id (congrArg (fun _a => MeasureTheory.MemLp _a 2 μ) heq)) hscaled
