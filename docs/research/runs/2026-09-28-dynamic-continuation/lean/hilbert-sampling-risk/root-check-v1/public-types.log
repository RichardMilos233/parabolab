                      (mul_pow |a j| ‖sampleMean (Y j) ω - h j‖ 2)))
                  (Eq.mpr
                    (id
                      (congrArg
                        (fun _a => _a * ‖sampleMean (Y j) ω - h j‖ ^ 2 = a j ^ 2 * ‖sampleMean (Y j) ω - h j‖ ^ 2)
                        (sq_abs (a j))))
