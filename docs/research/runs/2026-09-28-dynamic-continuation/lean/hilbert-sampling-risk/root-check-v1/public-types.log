        (‖b + ∑ j, a j • h j - c‖ ^ 2 + ∑ j, a j ^ 2 * ‖sampleMean (Y j) ω - h j‖ ^ 2)
        ((fun {α β γ} [HAdd α β γ] a a_1 e_a =>
            Eq.rec (motive := fun a_2 e_a => ∀ (a_3 a_4 : β), a_3 = a_4 → a + a_3 = a_2 + a_4)
              (fun a_2 a_3 e_a => e_a ▸ Eq.refl (a + a_2)) e_a)
          (‖b + ∑ j, a j • h j - c‖ ^ 2) (‖b + ∑ j, a j • h j - c‖ ^ 2) (Eq.refl (‖b + ∑ j, a j • h j - c‖ ^ 2))
          (∑ j, ‖a j • (sampleMean (Y j) ω - h j)‖ ^ 2) (∑ j, a j ^ 2 * ‖sampleMean (Y j) ω - h j‖ ^ 2)
