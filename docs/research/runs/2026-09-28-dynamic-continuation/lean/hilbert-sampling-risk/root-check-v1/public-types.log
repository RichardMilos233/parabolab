theorem EstimatorIntegrity.HilbertSamplingRisk.rawEstimator_pointwise_sq_le.{u_1, u_2} : ∀ {Ω : Type u_1} {H : Type u_2}
  [MeasurableSpace Ω] [inst : NormedAddCommGroup H] [inst_1 : InnerProductSpace ℝ H] [CompleteSpace H]
  [inst_3 : MeasurableSpace H] [BorelSpace H] {m n : ℕ} (Y : Fin m → Fin n → Ω → H) (a : Fin m → ℝ) (b c : H)
  (h : Fin m → H) (ω : Ω),
  ‖rawEstimator Y a b ω - c‖ ^ 2 ≤
    (↑m + 1) * (‖b + ∑ j, a j • h j - c‖ ^ 2 + ∑ j, a j ^ 2 * ‖sampleMean (Y j) ω - h j‖ ^ 2) :=
