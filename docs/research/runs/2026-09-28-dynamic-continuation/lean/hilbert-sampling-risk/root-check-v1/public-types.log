fun {Ω} {H} [NormedAddCommGroup H] [InnerProductSpace ℝ H] {m n} Y a b => (fun x => b) + ∑ j, a j • sampleMean (Y j)
theorem EstimatorIntegrity.HilbertSamplingRisk.norm_sum_sq_le_card_mul_sum_norm_sq.{u_2, u_3} : ∀ {H : Type u_2}
  [inst : NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [inst_3 : MeasurableSpace H] [BorelSpace H]
  {ι : Type u_3} [inst_5 : Fintype ι] (z : ι → H), ‖∑ i, z i‖ ^ 2 ≤ ↑(Fintype.card ι) * ∑ i, ‖z i‖ ^ 2 :=
fun {H} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [MeasurableSpace H] [BorelSpace H] {ι}
    [Fintype ι] z =>
  have hnorm := norm_sum_le Finset.univ z;
  Trans.trans
    (Trans.trans
      (Trans.trans ((sq_le_sq₀ (norm_nonneg (∑ i, z i)) (Finset.sum_nonneg fun x x_1 => norm_nonneg (z x))).mpr hnorm)
        (of_eq_true
          (Eq.trans
            (congrArg (Eq ((∑ i, ‖z i‖) ^ 2))
              (congrFun' (congrArg HPow.hPow (Finset.sum_congr (Eq.refl Finset.univ) fun x a => one_mul ‖z x‖)) 2))
            (eq_self ((∑ i, ‖z i‖) ^ 2)))))
      (Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun x => 1) fun i => ‖z i‖))
    (of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq
            (congrFun'
              (congrArg HMul.hMul
                (Eq.trans (Eq.trans (Finset.sum_congr (Eq.refl Finset.univ) fun x a => one_pow 2) (Finset.sum_const 1))
                  (Eq.trans (nsmul_eq_mul (Fintype.card ι) 1) (mul_one ↑(Fintype.card ι)))))
              (∑ i, ‖z i‖ ^ 2)))
          (↑(Fintype.card ι) * ∑ i, ‖z i‖ ^ 2))
        (eq_self (↑(Fintype.card ι) * ∑ i, ‖z i‖ ^ 2))))
theorem EstimatorIntegrity.HilbertSamplingRisk.norm_bias_add_sum_sq_le.{u_2} : ∀ {H : Type u_2}
  [inst : NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [inst_3 : MeasurableSpace H] [BorelSpace H]
  {m : ℕ} (bias : H) (e : Fin m → H), ‖bias + ∑ j, e j‖ ^ 2 ≤ (↑m + 1) * (‖bias‖ ^ 2 + ∑ j, ‖e j‖ ^ 2) :=
fun {H} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [MeasurableSpace H] [BorelSpace H] {m} bias
    e =>
  let z := fun x =>
    match x with
    | none => bias
    | some j => e j;
  have h := norm_sum_sq_le_card_mul_sum_norm_sq z;
  Eq.mpr (id ge_iff_le._simp_1)
    (Eq.mp
      (congr
        (congrArg LE.le
          (congrFun'
            (congrArg HPow.hPow
              (congrArg norm
                (Eq.trans
                  (Eq.trans
                    (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                      Eq.refl
                        (match x with
                        | none => bias
                        | some j => e j))
                    (Fintype.sum_option fun i =>
                      match i with
                      | none => bias
                      | some j => e j))
                  (congrArg (HAdd.hAdd bias) (Finset.sum_congr (Eq.refl Finset.univ) fun x a => Eq.refl (e x))))))
            2))
        (congr
          (congrArg HMul.hMul
            (Eq.trans
              (Eq.trans
                (congrArg Nat.cast
                  (Eq.trans Fintype.card_option (congrFun' (congrArg HAdd.hAdd (Fintype.card_fin m)) 1)))
                (Nat.cast_add m 1))
              (congrArg (HAdd.hAdd ↑m) Nat.cast_one)))
          (Eq.trans
            (Eq.trans
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                Eq.refl
                  (‖match x with
                      | none => bias
                      | some j => e j‖ ^
                    2))
              (Fintype.sum_option fun i =>
                ‖match i with
                    | none => bias
                    | some j => e j‖ ^
                  2))
            (congrArg (HAdd.hAdd (‖bias‖ ^ 2))
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a => Eq.refl (‖e x‖ ^ 2))))))
      h)
theorem EstimatorIntegrity.HilbertSamplingRisk.rawEstimator_sub_eq.{u_1, u_2} : ∀ {Ω : Type u_1} {H : Type u_2}
  [MeasurableSpace Ω] [inst : NormedAddCommGroup H] [inst_1 : InnerProductSpace ℝ H] [CompleteSpace H]
  [inst_3 : MeasurableSpace H] [BorelSpace H] {m n : ℕ} (Y : Fin m → Fin n → Ω → H) (a : Fin m → ℝ) (b c : H)
  (h : Fin m → H) (ω : Ω), rawEstimator Y a b ω - c = b + ∑ j, a j • h j - c + ∑ j, a j • (sampleMean (Y j) ω - h j) :=
fun {Ω} {H} [MeasurableSpace Ω] [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [MeasurableSpace H]
    [BorelSpace H] {m n} Y a b c h ω =>
  Eq.mpr
    (id
      (congr
        (congrArg Eq
          (congrFun'
            (congrArg HSub.hSub
              (congrArg (HAdd.hAdd b)
                (Eq.trans (Finset.sum_apply ω Finset.univ fun c => a c • sampleMean (Y c))
                  (Finset.sum_congr (Eq.refl Finset.univ) fun x a_1 => Eq.refl (a x • sampleMean (Y x) ω)))))
            c))
        (congrArg (HAdd.hAdd (b + ∑ j, a j • h j - c))
          (Eq.trans (Finset.sum_congr (Eq.refl Finset.univ) fun x a_1 => smul_sub (a x) (sampleMean (Y x) ω) (h x))
            (Finset.sum_sub_distrib (fun x => a x • sampleMean (Y x) ω) fun x => a x • h x)))))
    (rawEstimator_sub_eq._abel_1_2 Y a b c h ω)
