  {H : Type u_2} [inst : MeasurableSpace Ω] [inst_1 : NormedAddCommGroup H] [inst_2 : InnerProductSpace ℝ H]
  [CompleteSpace H] [inst_4 : MeasurableSpace H] [BorelSpace H] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] {m n : ℕ},
  0 < n →
    ∀ (Y : Fin m → Fin n → Ω → H) (h : Fin m → H) (V a : Fin m → ℝ) (b c : H) (β : ℝ),
      0 ≤ β →
        (∀ (j : Fin m), 0 ≤ V j) →
          (∀ (j : Fin m) (i : Fin n), MeasureTheory.MemLp (Y j i) 2 μ) →
            (∀ (j : Fin m), Pairwise fun i k => ProbabilityTheory.IndepFun (Y j i) (Y j k) μ) →
              (∀ (j : Fin m) (i : Fin n), ∫ (ω : Ω), Y j i ω ∂μ = h j) →
                (∀ (j : Fin m) (i : Fin n), ∫ (ω : Ω), ‖Y j i ω‖ ^ 2 ∂μ ≤ V j) →
                  ‖b + ∑ j, a j • h j - c‖ ≤ β →
                    ∀ (K : H → H),
                      Continuous K →
                        (∀ (z : H), ‖K z - c‖ ≤ ‖z - c‖) →
                          ∫ (ω : Ω), ‖K (rawEstimator Y a b ω) - c‖ ^ 2 ∂μ ≤
                            (↑m + 1) * (β ^ 2 + ∑ j, a j ^ 2 * V j / ↑n) :=
