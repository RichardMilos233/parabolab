  [inst : MeasurableSpace Ω] [inst_1 : Fintype I] [inst_2 : MeasurableSpace (EuclideanSpace ℝ I)]
  [BorelSpace (EuclideanSpace ℝ I)] (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] {m n : ℕ},
  0 < n →
    ∀ (Y : Fin m → Fin n → Ω → EuclideanSpace ℝ I) (h : Fin m → EuclideanSpace ℝ I) (V a : Fin m → ℝ)
